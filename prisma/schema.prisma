generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  role        String
  eyebrow     String
  headline    String
  subhead     String
  bio         String[]
  email       String
  githubUrl   String
  linkedinUrl String
  location    String
  resumeUrl   String
  focusText     String @default("Backend & Microservices")
  currentlyText String @default("IT Business Integration Intern @ Alfamart")
  openToText    String @default("Full-time backend roles")
  valueProposition String @default("Add your value proposition in /admin/profile")
  updatedAt   DateTime @updatedAt
}

model SkillCategory {
  id       String   @id @default(cuid())
  category String
  items    String[]
  order    Int      @default(0)
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  type        String
  role        String
  year        String
  description String
  highlights  String[]
  tags        String[]
  href        String
  imageUrl    String
  order       Int      @default(0)
  published   Boolean  @default(true)
  challenge   String?
  solution    String?
  result      String?
  gallery     String[]
  hasCaseStudy Boolean @default(false)
  updatedAt   DateTime @updatedAt
}

model ExperienceItem {
  id     String   @id @default(cuid())
  role   String
  org    String
  period String
  points String[]
  order  Int      @default(0)
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  issuer      String
  date        String
  url         String?
  description String?
  order       Int      @default(0)
}

model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model Post {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String
  content       String
  coverImageUrl String?
  tags          String[]
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
